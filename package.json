{
  "name": "n8n-nodes-sotaproxy",
  "version": "0.1.0",
  "description": "n8n node for SotaProxy - buy and manage residential, ISP, IPv4/IPv6 and mobile proxies from your workflows",
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "sotaproxy",
    "proxy",
    "proxies",
    "residential-proxy",
    "mobile-proxy",
    "web-scraping"
  ],
  "license": "MIT",
  "homepage": "https://sotaproxy.com/en/api-docs",
  "author": {
    "name": "SotaProxy",
    "email": "support@sotaproxy.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SotaProxy/n8n-nodes-sotaproxy.git"
  },
  "engines": {
    "node": ">=20.15"
  },
  "main": "index.js",
  "scripts": {
    "build": "npx rimraf dist && tsc && gulp build:icons",
    "dev": "tsc --watch",
    "format": "prettier nodes credentials --write",
    "lint": "eslint nodes credentials package.json",
    "lintfix": "eslint nodes credentials package.json --fix"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/SotaProxyApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/SotaProxy/SotaProxy.node.js"
    ]
  },
  "devDependencies": {
    "@typescript-eslint/parser": "^8.32.0",
    "eslint": "^8.57.0",
    "eslint-plugin-n8n-nodes-base": "^1.16.3",
    "gulp": "^5.0.0",
    "n8n-workflow": "*",
    "prettier": "^3.5.3",
    "typescript": "^5.8.3"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  }
}
